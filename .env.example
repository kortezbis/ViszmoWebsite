# Copy to .env.local and fill in values.
# Production API should use your Supabase custom domain (not *.supabase.co).
#
# In Supabase Dashboard: Project Settings → Custom Domains → add api.viszmo.com
# and complete DNS (CNAME) as shown there. The anon key does not change.
#
VITE_SUPABASE_URL=https://api.viszmo.com
VITE_SUPABASE_ANON_KEY=

# Used by Expo / mobile tooling if present
EXPO_PUBLIC_SUPABASE_URL=https://api.viszmo.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Not loaded from this file in production — set in the Supabase project UI / CLI.
#
# RESEND_API_KEY=re_...
# RESEND_FROM=Viszmo <noreply@mail.viszmo.com>
# Optional: WINDOWS_INSTALLER_URL = direct .exe on your domain (not GitHub). IOS_APP_STORE_URL for iOS emails.
# -----------------------------------------------------------------------------
